# Remote / multi-user mode (opt-in)
# Configure these in people-desk/.env.local for development or your hosting provider's secrets.
# DO NOT COMMIT real keys, emails, user passwords, or database dumps.
NEXT_PUBLIC_RH_DESK_REMOTE=1
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_LEGACY_ANON_KEY

# Keep the Supabase service_role/secret key OUT of this application.
